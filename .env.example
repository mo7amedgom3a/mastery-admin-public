# Admin dashboard build-time settings (Vite inlines VITE_* into the bundle; public values only).
# Copy to .env.local for local development. Production values are GitHub repository variables
# used by .github/workflows/deploy-pages.yml.

# Storefront the Course Studio and lab previews frame and talk to (postMessage target origin).
# Production: https://landing.emasteryacademy.com. Default when unset: http://localhost:3000.
VITE_STOREFRONT_ORIGIN=http://localhost:3000

# "true" shows the "Use QA account" button on /login (backend needs QA_LOGIN_ENABLED too).
VITE_QA_LOGIN_ENABLED=false
